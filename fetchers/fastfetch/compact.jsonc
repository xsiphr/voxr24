{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  ::  "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "cyan",
        "at": "white",
        "host": "green"
      }
    },
    {
      "type": "separator",
      "string": "━"
    },
    {
      "type": "os",
      "key": "os",
      "keyColor": "cyan"
    },
    {
      "type": "host",
      "key": "host",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "kernel",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "uptime",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "shell",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": "term",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "memory",
      "keyColor": "green"
    },
    "break",
    {
      "type": "colors",
      "symbol": "block"
    },
    "break"
  ]
}
