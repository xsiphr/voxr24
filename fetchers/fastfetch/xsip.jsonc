{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "endeavouros_small",
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "    ",
    "color": {
      "keys": "cyan"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "cyan",
        "at": "white",
        "host": "cyan"
      }
    },
    {
      "type": "os",
      "key": "os      "
    },
    {
      "type": "host",
      "key": "host    "
    },
    {
      "type": "kernel",
      "key": "kernel  "
    },
    {
      "type": "uptime",
      "key": "uptime  "
    },
    {
      "type": "memory",
      "key": "memory  "
    },
    {
      "type": "command",
      "key": "os life ",
      "text": "if [ -f /var/log/pacman.log ]; then echo \"$(( ($(date +%s) - $(date -d \"$(head -n1 /var/log/pacman.log 2>/dev/null | cut -d' ' -f1 | tr -d '[]')\" +%s 2>/dev/null || date +%s)) / 86400 )) days\"; else echo \"$(( ($(date +%s) - $(stat -c %W / 2>/dev/null || stat -c %Y / 2>/dev/null || date +%s)) / 86400 )) days\"; fi"
    },
    "break"
  ]
}
