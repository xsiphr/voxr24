{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " ➜  "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}@{2}",
      "color": {
        "user": "magenta",
        "at": "white",
        "host": "blue"
      }
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "OS   ",
      "keyColor": "magenta"
    },
    {
      "type": "kernel",
      "key": " ├  ",
      "keyColor": "magenta"
    },
    {
      "type": "packages",
      "key": " ├ 󰏖 ",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": " ├  ",
      "keyColor": "magenta"
    },
    {
      "type": "uptime",
      "key": " └ 󰥔 ",
      "keyColor": "magenta"
    },
    "break",
    {
      "type": "host",
      "key": "PC   ",
      "keyColor": "blue"
    },
    {
      "type": "cpu",
      "key": " ├  ",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "key": " ├ 󰢮 ",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": " └ 󰘚 ",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break"
  ]
}
